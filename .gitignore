# Éditeur / OS
.DS_Store
Thumbs.db
desktop.ini
.cursor/

# Environnements Python locaux
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Couverture de tests (artefacts régénérés à chaque exécution)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets (ne jamais versionner)
.env
.env.*

# Scripts d'automatisation locaux (ne pas pousser sur GitHub)
publier_git.bat
scripts/git_commit_message.ps1

# Dépendances Node.js et builds Tailwind (artefacts régénérés au build)
node_modules/
css/tailwind.built.css
css/styles.built.css
dist/

# Cache local de génération d'assets (polices TTF téléchargées)
scripts/_assets_cache/

# Rapports Lighthouse exportés localement (audit ponctuel du site déployé,
# ~1,4 Mo pièce). Utiles sur le moment, jamais versionnés : sans cette règle
# le « git add -A » de publier_git.bat les embarquerait dans l'historique.
*.netlify.app_*.html
lighthouse-report*.html
.lighthouseci/

